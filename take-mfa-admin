#!/usr/local/cpanel/3rdparty/bin/perl
use strict;
use warnings;
use lib '/usr/local/cpanel','/usr/local/cpanel/3rdparty/take-mfa/lib';
use TakeMFA::Core ();
die "Run as root over SSH.\n" if $>!=0;
my ($action,$user,$confirmation)=@ARGV;
if (($action//'') eq 'status' && @ARGV==1) {print join("\n",@{TakeMFA::Core::status()}),"\n";exit 0;}
if (($action//'') eq 'reset' && @ARGV==3 && defined($user) && $confirmation eq $user) {
    TakeMFA::Core::reset($user);print "Custom MFA reset for $user. Re-enroll from WHM. No other account changed.\n";exit 0;
}
die "Usage: take-mfa-admin status\n       take-mfa-admin reset USER USER\nReset is an explicit root-only recovery action; it turns off only the selected user's custom factor.\n";
