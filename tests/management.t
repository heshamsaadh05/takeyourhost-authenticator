use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use FindBin ();
use TakeMFA::Core ();
use TakeMFA::Manage ();
use TakeMFA::QR ();
use TakeMFA::Console ();
local $TakeMFA::QR::PROGRAM=($ENV{TAKE_MFA_TEST_PACKAGE}//"$FindBin::Bin/..").'/qr-svg.py';
my $base=tempdir('take-mfa-tests-XXXXXXXX',TMPDIR=>1,CLEANUP=>1);
my $dir=tempdir('management-unit-XXXXXXXX',DIR=>$base,CLEANUP=>1);chmod(0700,$dir);
local $TakeMFA::Core::ROOT=$dir;
TakeMFA::Core::_write($dir.'/enabled.json',{});TakeMFA::Core::_write($dir.'/settings.json',{mode=>'available'});
my $clock=2_000_000_010;local $TakeMFA::Core::CLOCK=sub {$clock};
my $a='tester:AAAAAAAAAAAAAAAA';my $b='tester:BBBBBBBBBBBBBBBB';my $root='root:RRRRRRRRRRRRRRRR';
my $p=TakeMFA::Core::begin_enrollment('tester',$a);
my $c=TakeMFA::Core::confirm_enrollment('tester',$a,$p->{nonce},TakeMFA::Core::code_at($p->{secret},$clock));
ok($c->{ok},'management fixture enrolled');
my $d=TakeMFA::Manage::dashboard('tester',$a);
ok($d->{enrolled} && !$d->{paused} && $d->{global_enabled},'dashboard status accurate');
ok(!exists($d->{secret}) && !exists($d->{accounts}),'dashboard does not expose active secret or other users');
is($d->{recovery_count},10,'recovery count accurate');
ok(!eval {TakeMFA::Manage::action('tester',$a,$d->{nonce},'000000','global_off');1},'reseller cannot change global policy');
$clock+=30;my $code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(!TakeMFA::Manage::action('tester',$a,'wrong',$code,'pause')->{ok},'management rejects invalid nonce');
ok(!TakeMFA::Manage::action('tester',$b,$d->{nonce},$code,'pause')->{ok},'management rejects another session nonce');
ok(TakeMFA::Core::protected('tester'),'failed management attempts do not lower protection');
ok(TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'pause')->{ok},'fresh OTP permits own pause');
ok(!TakeMFA::Core::protected('tester'),'pause is enforced');
ok(TakeMFA::Core::_registry()->{tester},'pause preserves enrollment');
is(TakeMFA::Core::_state('tester')->{secret},$p->{secret},'pause preserves existing secret');
ok(!TakeMFA::Core::verified('tester',$a),'pause invalidates old session grants');
$d=TakeMFA::Manage::dashboard('tester',$a);
ok(!TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'resume')->{ok},'same code cannot resume after pause');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'resume')->{ok},'next OTP resumes existing factor');
ok(TakeMFA::Core::protected('tester'),'resumed factor enforced');
ok(TakeMFA::Core::protected('tester','cpaneld'),'registered factor protects cPanel by default');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);$d=TakeMFA::Manage::dashboard('tester',$a);
ok(TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'pause_cpanel')->{ok},'fresh credential pauses only cPanel');
ok(!TakeMFA::Core::protected('tester','cpaneld') && TakeMFA::Core::protected('tester','whostmgrd'),'cPanel pause does not change WHM protection');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);$d=TakeMFA::Manage::dashboard('tester',$a);
ok(TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'resume_cpanel')->{ok},'fresh credential resumes cPanel');
ok(TakeMFA::Core::protected('tester','cpaneld'),'cPanel protection resumes');
ok(TakeMFA::Core::verified('tester',$a),'resume grants only management session');
ok(!TakeMFA::Core::verified('tester',$b),'resume does not grant different session');
$d=TakeMFA::Manage::dashboard('tester',$a);
my $rec=$c->{recovery_codes}[0];
my $r=TakeMFA::Manage::action('tester',$a,$d->{nonce},$rec,'recovery');
ok($r->{ok} && @{$r->{recovery_codes}}==10,'recovery allows guarded recovery regeneration');
my $ch=TakeMFA::Core::challenge('tester',$b);
ok(!TakeMFA::Core::verify('tester',$b,$ch->{nonce},$c->{recovery_codes}[1])->{ok},'old unused recovery invalidated');
ok(TakeMFA::Core::verify('tester',$b,$ch->{nonce},$r->{recovery_codes}[0])->{ok},'new recovery accepted');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);$d=TakeMFA::Manage::dashboard('tester',$a);
ok(TakeMFA::Manage::action('tester',$a,$d->{nonce},$code,'rotate')->{ok},'rotation requires credential');
is(TakeMFA::Core::_state('tester')->{secret},$p->{secret},'old secret retained during rotation');
ok(TakeMFA::Core::protected('tester'),'old protection retained during rotation');
$d=TakeMFA::Manage::dashboard('tester',$a);my $rot=$d->{rotation};
like($rot->{secret},qr/\A[A-Z2-7]{32}\z/,'rotation secret generated');
ok(!exists(TakeMFA::Manage::dashboard('tester',$b)->{rotation}),'rotation secret not exposed in another session');
my $newcode=TakeMFA::Core::code_at($rot->{secret},$clock);
ok(!TakeMFA::Manage::confirm_rotation('tester',$b,$rot->{nonce},$newcode)->{ok},'rotation cannot be confirmed across sessions');
ok(!TakeMFA::Manage::confirm_rotation('tester',$a,'bad',$newcode)->{ok},'rotation confirmation requires nonce');
$r=TakeMFA::Manage::confirm_rotation('tester',$a,$rot->{nonce},$newcode);
ok($r->{ok},'new app code completes rotation');
is(TakeMFA::Core::_state('tester')->{secret},$rot->{secret},'new secret active only after confirmation');
ok(!TakeMFA::Core::verified('tester',$b),'rotation revokes all prior other session grants');
ok(!exists(TakeMFA::Manage::dashboard('tester',$a)->{rotation}),'completed rotation secret not re-exposed');
ok(!TakeMFA::Manage::confirm_rotation('tester',$a,$rot->{nonce},$newcode)->{ok},'rotation confirmation not replayable');
$p=TakeMFA::Core::begin_enrollment('root',$root);
$c=TakeMFA::Core::confirm_enrollment('root',$root,$p->{nonce},TakeMFA::Core::code_at($p->{secret},$clock));
my $rd=TakeMFA::Manage::dashboard('root',$root);
is(scalar(@{$rd->{accounts}}),2,'root can see enrollment status list without secrets');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(!TakeMFA::Manage::action('root',$root,'bad',$code,'global_off')->{ok},'global off requires nonce');
ok(TakeMFA::Manage::action('root',$root,$rd->{nonce},$code,'global_off')->{ok},'root can suspend globally with fresh factor');
ok(!TakeMFA::Core::protected('root') && !TakeMFA::Core::protected('tester'),'global suspension enforced for both users');
ok(TakeMFA::Core::_registry()->{root} && TakeMFA::Core::_registry()->{tester},'global suspension preserves all enrolled factors');
$rd=TakeMFA::Manage::dashboard('root',$root);
ok(!TakeMFA::Manage::action('root',$root,$rd->{nonce},$code,'global_on')->{ok},'global enable also requires fresh proof');
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(TakeMFA::Manage::action('root',$root,$rd->{nonce},$code,'global_on')->{ok},'root can restore globally using existing app');
ok(TakeMFA::Core::protected('root') && TakeMFA::Core::protected('tester'),'global enable restores enforcement');
my $un='unregistered:UUUUUUUUUUUUUUUU';my $ud=TakeMFA::Manage::dashboard('unregistered',$un);
ok(!TakeMFA::Manage::action('unregistered',$un,$ud->{nonce},'123456','resume')->{ok},'unenrolled account cannot use management actions');
my $svg=TakeMFA::QR::svg('tester','A'x32);
like($svg,qr/\A<svg /,'local QR renderer returns SVG');
unlike($svg,qr/(?:script|https?:\/\/(?!www\.w3\.org)|otpauth:|secret=)/,'SVG has no external resources or embedded plaintext URI');
ok(!eval {TakeMFA::QR::svg('tester','bad');1},'invalid QR secret rejected');
local $ENV{cp_security_token}='/cpsess1234567890';
my $html=TakeMFA::Console::render('tester','/cpsess1234567890',TakeMFA::Manage::dashboard('tester',$a),undef,undef,'','');
unlike($html,qr/id="server"|name="action" value="global_/,'reseller UI contains no global controls');
unlike($html,qr/data-take-mfa="setup-key"/,'enrolled dashboard does not show existing secret');
like($html,qr/name="ack" value="1" required/,'dangerous UI actions require explicit acknowledgement');
$html=TakeMFA::Console::render('root','/cpsess1234567890',TakeMFA::Manage::dashboard('root',$root),undef,undef,'','');
like($html,qr/name="action" value="global_off"/,'root UI has global controls');
unlike($html,qr/\Q$p->{secret}\E/,'root active secret not rendered');
$rd=TakeMFA::Manage::dashboard('root',$root);
for(1..5){TakeMFA::Manage::action('root',$root,$rd->{nonce},'not-a-code','pause');}
$clock+=30;$code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(!TakeMFA::Manage::action('root',$root,$rd->{nonce},$code,'pause')->{ok},'management uses account-wide cooldown');
$clock+=181;$code=TakeMFA::Core::code_at($p->{secret},$clock);
ok(TakeMFA::Manage::action('root',$root,$rd->{nonce},$code,'rotate')->{ok},'management resumes after cooldown');
$rd=TakeMFA::Manage::dashboard('root',$root);my $oldsecret=TakeMFA::Core::_state('root')->{secret};
ok(TakeMFA::Manage::action('root',$root,$rd->{nonce},undef,'cancel_rotation')->{ok},'nonce-protected cancellation does not need additional OTP');
is(TakeMFA::Core::_state('root')->{secret},$oldsecret,'cancelling rotation preserves active secret');
ok(!exists(TakeMFA::Manage::dashboard('root',$root)->{rotation}),'cancelled rotation secret disappears');
{
    no warnings 'redefine';
    local *TakeMFA::Ownership::owns=sub {return $_[0] eq 'tester' && $_[1] eq 'clientone';};
    my $cs='clientone:QQQQQQQQQQQQQQQQ';my $cp=TakeMFA::Core::begin_enrollment('clientone',$cs);
    TakeMFA::Core::confirm_enrollment('clientone',$cs,$cp->{nonce},TakeMFA::Core::code_at($cp->{secret},$clock));
    $clock+=30;my $td=TakeMFA::Manage::dashboard('tester',$a);my $tc=TakeMFA::Core::code_at($rot->{secret},$clock);
    ok(!eval {TakeMFA::Manage::client_action('tester',$a,$td->{nonce},$tc,'foreignacct','client_pause');1},'non-owned customer rejected before any state mutation');
    ok(!TakeMFA::Manage::client_action('tester',$a,'wrong',$tc,'clientone','client_pause')->{ok},'customer toggle requires reseller session nonce');
    ok(TakeMFA::Manage::client_action('tester',$a,$td->{nonce},$tc,'clientone','client_pause')->{ok},'reseller fresh factor can pause owned customer cPanel');
    ok(!TakeMFA::Core::protected('clientone','cpaneld') && TakeMFA::Core::protected('clientone','whostmgrd'),'customer cPanel pause does not alter other service coverage');
    is(TakeMFA::Core::_state('clientone')->{secret},$cp->{secret},'reseller toggle never replaces customer secret');
    $td=TakeMFA::Manage::dashboard('tester',$a);
    ok(!TakeMFA::Manage::client_action('tester',$a,$td->{nonce},$tc,'clientone','client_resume')->{ok},'customer toggle replay rejected');
    $clock+=30;$tc=TakeMFA::Core::code_at($rot->{secret},$clock);
    ok(TakeMFA::Manage::client_action('tester',$a,$td->{nonce},$tc,'clientone','client_resume')->{ok},'next reseller code resumes owned customer cPanel');
    ok(TakeMFA::Core::protected('clientone','cpaneld'),'customer protection restored');
}
done_testing();
